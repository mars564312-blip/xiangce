.github/workflows/build-ipa.yml
name: Build Tabula unsigned IPA

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-14
    timeout-minutes: 25
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Show Xcode version
        run: xcodebuild -version

      - name: List targets (diagnostic)
        run: xcodebuild -list -project TabulaV3IOS.xcodeproj

      - name: Build unsigned app
        run: |
          xcodebuild \
            -project TabulaV3IOS.xcodeproj \
            -target TabulaV3IOS \
            -configuration Release \
            -sdk iphoneos \
            -derivedDataPath ./DerivedData \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGN_IDENTITY="" \
            CODE_SIGNING_REQUIRED=NO \
            build

      - name: Pack IPA
        run: |
          APP="./DerivedData/Build/Products/Release-iphoneos/TabulaV3IOS.app"
          if [ ! -d "$APP" ]; then
            echo "::error::编译产物不存在: $APP"
            exit 1
          fi
          mkdir -p Payload
          cp -R "$APP" Payload/
          zip -q -r TabulaV3IOS-unsigned.ipa Payload
          ls -lh TabulaV3IOS-unsigned.ipa

      - name: Upload IPA artifact
        uses: actions/upload-artifact@v4
        with:
          name: TabulaV3IOS-unsigned-ipa
          path: TabulaV3IOS-unsigned.ipa
          retention-days: 30
